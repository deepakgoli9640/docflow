      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kafka_dlt_records_total[24h])) or vector(0)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
