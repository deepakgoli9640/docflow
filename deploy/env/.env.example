# Copy to deploy/env/.env (git-ignored) or, better, run:  ./scripts/init-env.sh
# which fills every secret below with fresh random values.
# Docker Compose and the services (when run from the IDE) both read deploy/env/.env.

# --- PostgreSQL --------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
MERCHANT_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
REFUND_DB_PASSWORD=change-me
LEDGER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
RECON_DB_PASSWORD=change-me

# --- Security ----------------------------------------------------------------------------
# AES-256 key (base64 of 32 random bytes) for field encryption:  openssl rand -base64 32
HPG_ENCRYPTION_KEY=
# Client secrets for non-merchant OAuth2 clients. Empty = that client is disabled.
HPG_OPS_CLIENT_SECRET=
HPG_NOTIFICATION_CLIENT_SECRET=
# Optional PEM files for the JWT signing key. Empty = ephemeral key (development only).
HPG_JWT_PRIVATE_KEY_LOCATION=
HPG_JWT_PUBLIC_KEY_LOCATION=
# Local development only: allow http:// and localhost webhook URLs.
HPG_ALLOW_INSECURE_WEBHOOKS=true

# --- Kafka -------------------------------------------------------------------------------
# Only used by services you run outside Docker (IDE / mvn spring-boot:run with profile "local").
# Inside Compose each service is given kafka:9092 explicitly.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- Payment provider -----------------------------------------------------------------
# razorpay  = real Razorpay API (use TEST-mode keys below)
# simulated = in-memory SIMULATED provider for local demos without keys; no money moves.
HPG_PAYMENT_PROVIDER=simulated
# Razorpay TEST-mode credentials (rzp_test_...). Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Web console (profile "ui", http://localhost:8086) -------------------------------
# The console holds no credentials of its own: hospital staff sign in with an API key id and
# secret, operations with HPG_OPS_CLIENT_SECRET above (user "ops-console").
# Inside Compose these two are set to the container names; these defaults are for running the
# console from the IDE. HPG_TOKEN_ISSUER must equal the "iss" claim merchant-service issues.
HPG_GATEWAY_URI=http://localhost:8080
HPG_TOKEN_ISSUER=http://localhost:8081
# Must be true behind TLS: it marks the session cookie Secure.
HPG_CONSOLE_SECURE_COOKIES=false
