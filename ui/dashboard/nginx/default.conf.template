# Serves the dashboard and forwards API traffic to the gateway, so the browser sees one origin
# (no CORS) and every request still passes the gateway's authentication and rate limits.
server {
    listen 8090;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Strict CSP: only our own scripts/styles; no inline script, no third-party origins.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
    }

    # The patient checkout page, so payment links also open from a phone or another machine. It sends its own
    # nonce-based Content-Security-Policy; the add_header here stops the dashboard's CSP above from being
    # inherited (nginx only inherits add_header into locations that define none).
    location /checkout/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Content-Type-Options nosniff always;
    }

    # Single sign-on settings for the browser (js/oidc.js). The app hides SSO if the provider is unreachable.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 200 '{"oidc":{"authority":"${OIDC_AUTHORITY}","clientId":"${OIDC_CLIENT_ID}"}}';
    }

    # The identity provider (Keycloak) under the same origin, so login, token and logout need no CORS and the
    # dashboard's CSP can stay connect-src 'self'. Resolved per request, so the dashboard still starts when
    # no identity provider is deployed (the SSO button is then hidden). Keycloak sends its own CSP.
    location /auth/ {
        resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
        set $idp ${OIDC_UPSTREAM};
        proxy_pass $idp;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_buffer_size 16k;    # Keycloak's login responses carry large cookies/headers
        proxy_buffers 8 16k;
        add_header X-Content-Type-Options nosniff always;
    }

    location ~ ^/(api|oauth2)/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        client_max_body_size 21m;   # settlement-file uploads (the gateway allows 21 MB on that route only)
    }
}
