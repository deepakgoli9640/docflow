    <artifactId>hpg-messaging</artifactId>
    <name>HPG :: Platform :: Messaging</name>
    <description>
        Transactional outbox: services append events in the same database transaction as their business
        change. Phase 3 writes the outbox; the Kafka relay and idempotent consumers arrive in Phase 4.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.hpg</groupId>
            <artifactId>hpg-event-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
    </dependencies>
</project>
